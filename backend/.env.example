# ── Guardian Backend Environment Variables ────────────────────────────────────
# Copy this to .env and fill in real values before running.

# JWT Secrets — MUST be changed before any deployment
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ADMIN_SECRET=
JWT_EXPIRE_MINUTES=10080

# Admin
ADMIN_DEFAULT_PASSWORD=Guardian@Admin2025!

# Database paths (SQLite default — for dev only)
# Set these to postgresql+asyncpg://... for production
DB_DIR=.
# WORKER_DB_URL=postgresql+asyncpg://guardian:pass@localhost/guardian_workers
# ADMIN_DB_URL=postgresql+asyncpg://guardian:pass@localhost/guardian_admin
# ANALYTICS_DB_URL=postgresql+asyncpg://guardian:pass@localhost/guardian_analytics

# Redis (optional — enables cross-process WebSocket broadcast for multi-worker deploy)
# Leave blank to use in-process broadcast (fine for single Uvicorn worker / dev)
# REDIS_URL=redis://localhost:6379/0

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Weather API (get free key at openweathermap.org)
OPENWEATHER_API_KEY=

# DEV_MODE — set true ONLY for local development. NEVER in production/staging.
# When true, the OTP is returned in the send-otp API response for easy testing.
DEV_MODE=false

# OTP Rate Limiting
# Max OTP send requests per phone number per window (anti-SMS-bombing)
OTP_SEND_MAX=3
OTP_SEND_WINDOW_SECONDS=600
# Max OTP verify attempts per phone per window (anti-brute-force)
OTP_VERIFY_MAX=5
OTP_VERIFY_WINDOW_SECONDS=600
# Max wrong guesses before OTP is invalidated on the user row
OTP_MAX_ATTEMPTS=5

# SMS Gateway (see backend/sms.py for full docs)
# SMS_PROVIDER=console          # console (default) | twilio | msg91
#
# Twilio — https://console.twilio.com
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM_NUMBER=+14155552671
#
# MSG91 — https://control.msg91.com  (Indian numbers, cheaper)
# MSG91_AUTH_KEY=your_auth_key
# MSG91_SENDER_ID=GRDJOB
# MSG91_TEMPLATE_ID=your_dlt_template_id

# Razorpay (get keys from https://dashboard.razorpay.com)
# Use test keys (rzp_test_...) for development, live keys for production
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME_SECRET

# Docker / Postgres (used by docker-compose.yml)
# Override this — do not use the default in production
POSTGRES_PASSWORD=guardian_dev_pw
